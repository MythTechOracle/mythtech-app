PORT=8787
DB_PATH=./data/live-signals.sqlite
STATIC_ROOT=.
CORS_ORIGIN=*

# GDELT DOC 2.0
GDELT_DOC_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MODE=artlist
GDELT_MAX_RECORDS=15
GDELT_RETRY_MAX_RECORDS=10
GDELT_TIMESPAN=1day
GDELT_RETRY_TIMESPAN=1h
GDELT_BASKETS_PER_CYCLE=1
GDELT_BASKET_DELAY_MS=3000
GDELT_RETRY_MAX=2
GDELT_RETRY_BASE_MS=5000
GDELT_RETRY_MAX_MS=60000
GDELT_RETRY_JITTER_MS=750
GDELT_RATE_LIMIT_COOLDOWN_MS=900000
GDELT_REQUEST_TIMEOUT_MS=25000

# comma-separated basket list to ingest in v1
GDELT_BASKETS=security,diplomacy,infrastructure

# ACLED Phase 1
ACLED_ENABLED=false
ACLED_SHADOW_MODE=true
ACLED_BASE_URL=https://acleddata.com/api/
ACLED_ENDPOINT=acled/read
ACLED_TOKEN=your_oauth_bearer_token_here
ACLED_LIMIT=250
ACLED_MAX_PAGES=1
ACLED_LOOKBACK_HOURS=168
ACLED_COUNTRIES=
ACLED_EVENT_TYPES=

# RSS Phase 1
RSS_ENABLED=false
RSS_REQUEST_TIMEOUT_MS=15000
RSS_MAX_ITEMS_PER_FEED=15
RSS_FEEDS_JSON=[]
# example:
# RSS_FEEDS_JSON=[{"name":"U.S. State Department","url":"https://www.state.gov/feed/","category":"diplomacy","region":"Global","country":"US","confidence":0.8}]

# Event Registry Phase 2 placeholder
EVENT_REGISTRY_ENABLED=false
EVENT_REGISTRY_SHADOW_MODE=true
EVENT_REGISTRY_BASE_URL=https://eventregistry.org/api/v1
EVENT_REGISTRY_API_KEY=

# snapshot selection policy
LIVE_SNAPSHOT_MAX_AGE_MS=900000

# automatic refresh loop
LIVE_REFRESH_ENABLED=true
LIVE_REFRESH_INTERVAL_MS=600000
LIVE_REFRESH_RUN_ON_START=true
